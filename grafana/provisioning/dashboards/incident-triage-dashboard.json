{
  "uid": "incident-triage-overview",
  "annotations": {
    "list": []
  },
  "editable": true,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "incident-triage-prometheus"
      },
      "description": "How many requests the API handles each minute, averaged over 5 minutes.",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(incident_triage_http_requests_total{route!=\"/metrics\"}[5m])) * 60",
          "legendFormat": "requests/min",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "API requests per minute",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "incident-triage-prometheus"
      },
      "description": "How long the API takes to respond, on average.",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(incident_triage_http_request_duration_seconds_sum{route!=\"/metrics\"}[5m])) / clamp_min(sum(rate(incident_triage_http_request_duration_seconds_count{route!=\"/metrics\"}[5m])), 1e-9)",
          "legendFormat": "average",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Average API response time",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "incident-triage-prometheus"
      },
      "description": "Total triage runs, split into successful and failed runs.",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (status) (incident_triage_worker_runs_total)",
          "legendFormat": "{{status}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Triage runs completed",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "incident-triage-prometheus"
      },
      "description": "Number of monitored services Prometheus can reach right now.",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(up)",
          "legendFormat": "online",
          "range": false,
          "refId": "A",
          "instant": true
        }
      ],
      "title": "Services online",
      "type": "stat",
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "incident-triage"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Incident Triage - Simple Overview",
  "version": 2
}
