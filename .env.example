# Set DATABASE_URL in the environment only after provisioning the dedicated
# read-only role described in README.md. Do not use the Compose superuser.
# DATABASE_URL=postgresql://incident_readonly:<local-password>@localhost:2026/incidentdb
INCIDENT_DB_PATH=data/incidents.db
RUNBOOKS_PATH=corpus/runbooks
RATE_LIMIT_PER_MINUTE=30
TRIAGE_STUB_DELAY_SECONDS=0
RAG_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=
RAG_EMBEDDING_MODEL=
FAISS_INDEX_PATH=data/faiss
FASTEMBED_CACHE_DIR=data/fastembed
RAG_TOP_K=4
RAG_CHUNK_SIZE=1200
GROQ_TIMEOUT_SECONDS=30
